<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Qbot Keyboard!"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_enable_kb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Enable Keyboard in Settings" />

    <Button
        android:id="@+id/btn_select_kb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Select Qbot Keyboard" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Keyboard Layout:"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_qwerty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QWERTY"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_numeric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NUMERIC" />
    </RadioGroup>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="Test your keyboard here" />

</LinearLayout>
